# Copie para .env e ajuste. O .env nunca vai para o repositório.

PORT=3000
HOST=0.0.0.0

# Banco e broker do docker-compose.yml
DATABASE_URL=postgres://estac:estac@localhost:5432/estacionamento
MQTT_URL=mqtt://localhost:1883
# MQTT_USUARIO=
# MQTT_SENHA=

# Segredo dos tokens de login: troque por um texto aleatório com 32+ caracteres
JWT_SEGREDO=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
TOKEN_ACESSO_MIN=15
REFRESH_DIAS=30

# Portão
PORTAO_ID=principal
PORTAO_NOME="Portão principal"
COMANDO_VALIDADE_MS=5000
COMANDO_INTERVALO_MIN_MS=3000

# Endereço do app em desenvolvimento (separe vários por vírgula)
CORS_ORIGEM=http://localhost:5173
