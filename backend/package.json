{
  "name": "estacionamento-backend",
  "version": "0.1.0",
  "description": "API do app do estacionamento: usuários, comandos do portão, log e ponte MQTT com o ESP32.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "migrar": "tsx scripts/migrar.ts",
    "criar-admin": "tsx scripts/criar-admin.ts",
    "sim:esp32": "tsx scripts/esp32-simulado.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "aedes": "^1.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
